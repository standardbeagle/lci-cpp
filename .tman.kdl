defaults {
    stall "30m"
    max-parallel 2
    retain "24h"
    // opt-in ceilings; builds legitimately saturate cores and eat RAM
    // max-mem 8192
    // max-cpu 95
    // max-time "30m"
}

// The release preset (build/release) is the tree every drain gate and benchmark reads.
// `test` configures and builds first: ctest runs whatever binaries the tree holds, so a
// test alias that skipped the build would pass against stale code. Both steps are
// incremental, so the second pass in a build-then-test template costs seconds.
alias "build" {
    command "sh"
    args "-c" "cmake --preset release && cmake --build --preset release --parallel 4"
    max-time "60m"
}

alias "test" {
    command "sh"
    args "-c" "cmake --preset release && cmake --build --preset release --parallel 4 && ctest --preset release -j4"
    max-time "60m"
}

// The TSan leg CI runs. setarch -R turns off ASLR because the sanitizers abort on this
// kernel's default mmap entropy, and it wraps the build as well as ctest since
// gtest_discover_tests runs the instrumented binaries at build time. Instrumented
// processes take several GB each, so ctest runs two at a time, as in ci.yml.
// The sanitizer preset has no alias: GCC with UBSan cannot compile the abseil 20240722
// that FetchContent pins, so only CI's vcpkg abseil builds that leg.
alias "tsan" {
    command "sh"
    args "-c" "cmake --preset tsan && setarch \"$(uname -m)\" -R cmake --build --preset tsan --parallel 4 && setarch \"$(uname -m)\" -R ctest --preset tsan -j2"
    max-time "120m"
}

