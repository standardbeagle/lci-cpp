defaults {
    stall "30m"
    max-parallel 2
    retain "24h"
    // opt-in ceilings; builds legitimately saturate cores and eat RAM
    // max-mem 8192
    // max-cpu 95
    // max-time "30m"
}

// The release preset (build/release) is the tree every drain gate and benchmark reads.
// `test` configures and builds first: ctest runs whatever binaries the tree holds, so a
// test alias that skipped the build would pass against stale code. Both steps are
// incremental, so the second pass in a build-then-test template costs seconds.
alias "build" {
    command "sh"
    args "-c" "cmake --preset release && cmake --build --preset release --parallel 4"
    max-time "60m"
}

alias "test" {
    command "sh"
    args "-c" "cmake --preset release && cmake --build --preset release --parallel 4 && ctest --preset release -j4"
    max-time "60m"
}
