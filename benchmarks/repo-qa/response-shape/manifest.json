{
  "schema": "lci.response-shape.manifest.v1",
  "analysis_revision": "paired-task-v2",
  "grading_schema": "atomic-value-v3",
  "models": [
    {"id": "opencode-go/deepseek-v4-flash", "tier": "weak"},
    {"id": "opencode-go/glm-5.2", "tier": "strong"}
  ],
  "repetitions": 2,
  "timeout_seconds": 600,
  "arm_mapping": {"shape_17": "compact", "shape_42": "labeled"},
  "tokenizer": "whitespace-v1",
