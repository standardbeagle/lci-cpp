build/
# Root-anchored so test corpora like tests/.../build-junk/ stay trackable.
/build-*/
/build-*.log
.cache/
compile_commands.json
.worktrees/

# CTest scratch output
Testing/

# claude agent worktrees + loop locks (machine-local)
.claude/worktrees/
.claude/scheduled_tasks.lock

# dartai loop state (machine-local)
.dartai/

# Real projects test data (fetched via scripts/add-real-projects.sh)
real_projects/go/
real_projects/python/
real_projects/typescript/
real_projects/java/
real_projects/csharp/
real_projects/rust/
real_projects/php/
real_projects/kotlin/
real_projects/ruby/
real_projects/zig/

# tman supervised-run logs (per-clone)
/.tman/

# worktrack loop state (per-clone, may contain private email in lease_holder).
# The exported template manifest carries no per-clone state and is the designed
# repo carrier for workspace gate definitions, so it alone is tracked.
# (contents-glob, not the directory itself, so the manifest can be re-included
# — git cannot un-ignore a file under an excluded directory)
.worktrack/*
!.worktrack/templates.json

# worktrack MCP local database (per-clone, 7MB+)
worktrack-mcp.db

# Docs site (Astro Starlight) build output + deps
docs/node_modules/
docs/dist/
docs/.astro/
.work/
.xdg-cache-home/
.xdg-data-home/
