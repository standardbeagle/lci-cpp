{
  "id": "cli/debug/info",
  "golden": "goldens/cli/debug/info.txt",
  "mode": "cli",
  "corpus": "multi-lang",
  "go_binary": "${LCI_GO}",
  "cpp_binary": "${LCI_CPP}",
  "invocation": {
    "args": [
      "debug",
      "info"
    ],
    "cwd": "${CORPUS}"
  },
  "capture": [
    "stdout",
    "exit"
  ],
  "parse": "text",
  "tiers": {},
  "tolerances": {
    "score_abs": 0.0,
    "timed_max_ms": 60000
  },
  "expect_exit": 1,
  "text_normalize": {
    "strip_lines": [
      "Last Updated:"
    ]
  },
  "_rationale": "S9: debug subcommands print only numbers from the running server /status; with no server they exit non-zero after printing \"server not running\" (the previous hardcoded-zero output was fabricated)."
}
