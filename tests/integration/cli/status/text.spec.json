{
  "id": "cli/status/text",
  "golden": "goldens/cli/status/text.txt",
  "mode": "cli",
  "corpus": "multi-lang",
  "go_binary": "${LCI_GO}",
  "cpp_binary": "${LCI_CPP}",
  "invocation": {
    "args": [
      "status"
    ],
    "cwd": "${CORPUS}"
  },
  "capture": [
    "stdout",
    "exit"
  ],
  "parse": "text",
  "_rationale": "S9: lci status is a query, not a supervisor: with no server running it prints \"not running\" and exits 0 without spawning one.",
  "tiers": {},
  "tolerances": {
    "score_abs": 0.0,
    "timed_max_ms": 60000
  },
  "expect_exit": 0,
  "text_normalize": {
    "strip_lines": [
      "Uptime:",
      "Build time:",
      "Threads:",
      "RSS:",
      "Index size:"
    ]
  }
}
