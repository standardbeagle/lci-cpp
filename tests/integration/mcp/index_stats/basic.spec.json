{
  "id": "mcp/index_stats/basic",
  "golden": "goldens/mcp/index_stats/basic.json",
  "mode": "mcp",
  "corpus": "multi-lang",
  "go_binary": "${LCI_GO}",
  "cpp_binary": "${LCI_CPP}",
  "invocation": {
    "args": ["mcp"],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"index_stats\",\"arguments\":{}}}",
    "cwd": "${CORPUS}"
  },
  "capture": ["stdout", "exit"],
  "parse": "json",
  "_rationale": "index_stats had no e2e coverage at all. Volatile fields (timestamp, counts, index_time_ms) are masked by the shared MCP inner-text canonicalizer; the golden pins the response shape and server_ready/status semantics.",
  "tiers": {
    "stable": ["result.content[].type", "result.content[].text"],
    "ignore": ["id", "jsonrpc", "result.meta.elapsed_ms", "result.meta.server_pid"]
  },
  "tolerances": {"score_abs": 0.05, "timed_max_ms": 60000},
  "expect_exit": 0
}
