{
  "id": "http/ping",
  "golden": "goldens/http/ping.json",
  "mode": "http",
  "corpus": "multi-lang",
  "go_binary": "${LCI_GO}",
  "cpp_binary": "${LCI_CPP}",
  "invocation": {
    "args": ["/ping"],
    "cwd": "${CORPUS}"
  },
  "capture": ["stdout", "exit"],
  "parse": "json",
  "tiers": {
    "stable": [],
    "ignore": [
      "pid", "start_time", "uptime_ms", "elapsed_ms", "request_id",
      "timestamp", "schema_version",
      "uptime_seconds",
      "build_id",
      "version",
      "root"
    ]
  },
  "_rationale_ignore_root": "root echoes the absolute corpus path of the checkout running the suite (collision-detection field for clients); absolute paths differ per machine/worktree, so parity on it is meaningless.",
  "tolerances": {"score_abs": 0.05, "timed_max_ms": 60000},
  "expect_exit": 200
}
